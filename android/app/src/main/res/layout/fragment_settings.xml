<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingHorizontal="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="168dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Bootstrap peer. Seeded to a working public server on first run,
             so this page needs no attention at all to get connected. -->
        <TextView style="@style/SettingsHeader" android:text="Bootstrap peer" />
        <com.google.android.material.card.MaterialCardView style="@style/Widget.Fips.Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Bootstrap server">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/bootstrap_server"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    style="@style/Widget.Fips.Summary"
                    android:text="The public server your phone peers with to join the mesh. Any of them works — pick one near you. Choose “custom” to enter your own." />

                <!-- Shown only while the dropdown reads "custom": the peer
                     actually in use must be visible and editable here, not
                     buried in Advanced. -->
                <LinearLayout
                    android:id="@+id/custom_peer_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Peer npub">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/peer_npub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="Peer endpoint (host:port)">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/peer_endpoint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="Transport">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/peer_transport"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            app:simpleItems="@array/peer_transports" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <View style="@style/Widget.Fips.Divider" />
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/bootstrap_fallbacks"
                    style="@style/Widget.Fips.SettingSwitch"
                    android:text="Fallback bootstrap peers" />
                <TextView
                    style="@style/Widget.Fips.Summary"
                    android:text="Also peer with two other public servers, so the mesh stays reachable when your bootstrap server is down. Each extra link costs a short heartbeat every 20 seconds (10 with Battery saver off)." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/SettingsHeader" android:text="Security" />
        <com.google.android.material.card.MaterialCardView style="@style/Widget.Fips.Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/inbound_filter"
                    style="@style/Widget.Fips.SettingSwitch"
                    android:text="Block unsolicited inbound mesh traffic" />
                <TextView
                    style="@style/Widget.Fips.Summary"
                    android:text="Other mesh nodes can otherwise reach any port your selected apps listen on, like on a shared LAN. With this on, only replies to connections this phone opened, pings, and the ports allowed under Advanced get through — everything else is dropped (blocked ports show up in the Diagnostics log). fips itself needs no inbound ports." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/SettingsHeader" android:text="Connectivity" />
        <com.google.android.material.card.MaterialCardView style="@style/Widget.Fips.Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/lan_mdns"
                    style="@style/Widget.Fips.SettingSwitch"
                    android:text="LAN discovery (mDNS)" />
                <TextView
                    style="@style/Widget.Fips.Summary"
                    android:text="Finds nearby fips peers on your Wi-Fi for instant local connections. While on, your Wi-Fi chip stops filtering broadcast chatter from other devices (TVs, speakers, printers), and each message briefly wakes the phone — on a busy home network this costs noticeably more battery. No effect when off or on mobile data." />
                <View style="@style/Widget.Fips.Divider" />
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/nostr_discovery"
                    style="@style/Widget.Fips.SettingSwitch"
                    android:text="Discover peers via Nostr" />
                <!-- Text set in code: the link cap comes from
                     ConfigStore.DEF_NOSTR_DISCOVERY_MAX_PEERS. -->
                <TextView
                    android:id="@+id/nostr_discovery_summary"
                    style="@style/Widget.Fips.Summary" />
                <View style="@style/Widget.Fips.Divider" />
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/public_names"
                    style="@style/Widget.Fips.SettingSwitch"
                    android:text="Public domain names over fips" />
                <TextView
                    style="@style/Widget.Fips.Summary"
                    android:text="A website like www.example.ch can point its name at a fips node with a DNS record and a signed Nostr claim. With this on, such names reach the node over the mesh — even without internet once verified once — and every other name works exactly as before. Names are verified before use; nothing resolves on a claim alone." />
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/names_mesh_relays_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Mesh relays for public names">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/names_mesh_relays"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri|textMultiLine|textNoSuggestions"
                        android:minLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    style="@style/Widget.Fips.Summary"
                    android:text="Nostr relays running on fips nodes, one per line: ws://npub1….fips:port. They reach this phone over the mesh, so a domain whose claim carries a DNSSEC proof can be verified there even without internet and without having seen it before. Blank: none." />
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/names_witnesses_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Witnesses for public names">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/names_witnesses"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:minLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/names_attestation_k_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Witnesses that must agree">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/names_attestation_k"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    style="@style/Widget.Fips.Summary"
                    android:text="Nodes you trust to have checked a domain online, one npub1… per line — your own other nodes, or a friend\'s. Without internet, a domain never seen whose claim carries no DNSSEC proof is used once this many of them vouch for its server, through the mesh relays above. Only these keys are asked for; blank: attestations are not used. 0 witnesses that must agree also turns them off." />
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/names_witnesses_from_hosts"
                    style="@style/Widget.Fips.SettingSwitch"
                    android:layout_marginTop="8dp"
                    android:text="Trust my Mesh names as witnesses" />
                <TextView
                    style="@style/Widget.Fips.Summary"
                    android:text="Also count the nodes in Mesh names — the node the names sync from and every name\'s node — as witnesses, on top of the ones typed above. Off by default: a node you trust to serve a name is not automatically one you trust to vouch for other domains. A node never counts as a witness for its own domain. Applies at the next connect, so names synced later count from then on." />
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/names_dnssec"
                    style="@style/Widget.Fips.SettingSwitch"
                    android:layout_marginTop="8dp"
                    android:text="DNSSEC for public names" />
                <TextView
                    style="@style/Widget.Fips.Summary"
                    android:text="Validate a domain\'s DNS record with DNSSEC and accept the DNSSEC proof carried in its claim, which lets a domain never seen verify without internet. Leave this on. Off, the record is taken from plain DNS answers, and without internet only the witnesses above vouch — useful to test them." />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/names_forget_pins"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Forget verified domains" />
                <TextView
                    style="@style/Widget.Fips.Summary"
                    android:text="Drops every domain verified so far; each is verified again at its next lookup — from its DNS record, its claim\'s proof, or the witnesses. Reconnect to apply." />
                <View style="@style/Widget.Fips.Divider" />
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/hotspot"
                    style="@style/Widget.Fips.SettingSwitch"
                    android:text="FIPS Hotspot (!FIPS)" />
                <TextView
                    style="@style/Widget.Fips.Summary"
                    android:text="While connected, automatically joins nearby open hotspots named “!FIPS” — anywhere — and looks for fips peers there. Internet stays on your normal network. Needs the location permission (asked when enabling): Android hides Wi-Fi names without it. When you are already on another Wi-Fi, dual-Wi-Fi phones additionally join “!FIPS” as a second, local-only connection (one-time approval per hotspot). Requires Android 10+, full auto-join Android 12+." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/SettingsHeader" android:text="Power &amp; updates" />
        <com.google.android.material.card.MaterialCardView style="@style/Widget.Fips.Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/battery_saver"
                    style="@style/Widget.Fips.SettingSwitch"
                    android:text="Battery saver (relaxed timers)" />
                <TextView
                    style="@style/Widget.Fips.Summary"
                    android:text="Slows the mesh's background timers and heartbeats, cutting idle CPU and radio wakeups. Peers notice a dropped link a little later. Recommended on phones." />
                <View style="@style/Widget.Fips.Divider" />
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/auto_update"
                    style="@style/Widget.Fips.SettingSwitch"
                    android:text="Check for updates on start" />
                <TextView
                    style="@style/Widget.Fips.Summary"
                    android:text="Looks for a new release on GitHub each time the app opens and offers to install it (or postpone). Downloads are verified against the release checksum, and installing keeps your identity and settings. When off, updates are still available manually via Diagnostics → Check for updates." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Advanced: collapsed by default. Nothing in here needs touching
             for a normal connection. -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Fips.Card"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/advanced_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:baselineAligned="false"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.Fips.CardTitle"
                            android:text="Advanced" />

                        <TextView
                            style="@style/Widget.Fips.Summary"
                            android:layout_marginTop="2dp"
                            android:text="Defaults are fine for normal use. Change these only if you know why." />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/advanced_chevron"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="Expand advanced settings"
                        android:src="@drawable/ic_expand_more"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/advanced_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="16dp"
                    android:visibility="gone">

                    <TextView style="@style/SettingsSubHeader" android:text="Inbound firewall" />
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Allowed inbound ports">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inbound_ports"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <TextView
                        style="@style/Widget.Fips.Summary"
                        android:text="Comma-separated, e.g. 22, 8080. Blank allows none." />
                    <View style="@style/Widget.Fips.Divider" />
                    <TextView style="@style/SettingsSubHeader" android:text="Performance" />
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/forward_clearnet"
                        style="@style/Widget.Fips.SettingSwitch"
                        android:text="Forward non-mesh traffic (split tunnel)" />
                    <TextView
                        style="@style/Widget.Fips.Summary"
                        android:text="Keeps normal internet working in the apps you selected. Turning this off leaves them with mesh access only." />
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Worker threads (encrypt/decrypt)">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/worker_threads"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <View style="@style/Widget.Fips.Divider" />
                    <TextView style="@style/SettingsSubHeader" android:text="Logging" />
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Log level">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/log_level"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            app:simpleItems="@array/log_levels" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

    <!-- Appears only while something differs from what is stored, so it is
         both the save action and the "you have unsaved edits" signal. The
         bottom margin clears the activity's bottom navigation. -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/save"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="96dp"
        android:text="Save changes"
        android:visibility="gone" />
</FrameLayout>
