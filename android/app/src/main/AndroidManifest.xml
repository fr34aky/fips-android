<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- MulticastLock for LAN mDNS discovery (normal permission, no prompt) -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- requestNetwork for the FIPS Hotspot ("!FIPS") local-only secondary
         connection (normal permission, no prompt) -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- FIPS Hotspot auto-join: addNetworkSuggestions + reading scan results
         (normal permissions) ... -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- ... plus fine location (runtime grant, requested when the hotspot
         toggle is enabled): Android gates SSIDs/scan results behind it, and
         the service needs the matching foreground type to see them. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- In-app updater: hand the downloaded release APK to the system
         package installer (user confirms; signature must match). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Android 11+ package visibility: without this, the app picker can't see
         third-party apps (only default-visible system packages). We query the
         set of launchable apps so the mesh-app picker can list them. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".FipsApplication"
        android:label="fips2go"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:theme="@style/Theme.Fips">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AppPickerActivity"
            android:exported="false"
            android:label="Mesh apps" />

        <activity
            android:name=".RelaysActivity"
            android:exported="false"
            android:label="Nostr relays"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".HostsActivity"
            android:exported="false"
            android:label="Mesh names"
            android:windowSoftInputMode="adjustResize" />

        <!-- Exposes the downloaded update APK to the package installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="org.fips.android.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".FipsVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse|location"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Encrypted mesh VPN tunnel" />
            <!-- Opt out of Always-on VPN (honoured from API 27). The system
                 starts an always-on service with the bare
                 android.net.VpnService action, which onStartCommand does not
                 treat as a connect — so the service sat bound with no tunnel,
                 and with "Block connections without VPN" on top, the selected
                 apps lost all connectivity until someone opened the app and
                 tapped connect. Declaring it unsupported greys both toggles
                 out in Settings instead of offering a mode that cannot work.
                 Remove this only together with a real always-on start path. -->
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="false" />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
    </application>
</manifest>
